# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - API PORTFOLIO JAVA (DOCKER & LOCAL)
# ==============================================================================

# Porta da Aplicação
PORT=3333

# Perfil do Spring Boot (dev, prod, test)
SPRING_PROFILES_ACTIVE=prod

# Conexão com o MongoDB
# -> Para execução com Docker Compose: use 'mongodb' como host:
MONGO_URL=mongodb://mongodb:27017/api-portfolio-v2
# -> Para execução local fora do Docker (com Mongo no Docker ou local):
# MONGO_URL=mongodb://localhost:27017/api-portfolio-v2
# -> Para MongoDB Atlas:
# MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/api-portfolio-v2?retryWrites=true&w=majority

# Porta exposta para o MongoDB no Host
MONGO_PORT=27017

# Origens permitidas pelo CORS (separadas por vírgula)
ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://gabrielfeijo.com.br,https://www.gabrielfeijo.com.br

# Chave Secreta de Administrador para rotas de mutação (POST/PUT/DELETE em /v2/command e PUT/DELETE em /v2/review)
ADMIN_API_KEY=your_secure_admin_api_key_here

# Credenciais do Swagger UI (/swagger)
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin_password_here
SWAGGER_ENABLED=true

# Notificações em Tempo Real no Discord (Opcional - preencha se quiser receber webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
DISCORD_WEBHOOK_ENABLED=false
